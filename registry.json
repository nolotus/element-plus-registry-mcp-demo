{
  "$schema": "https://shadcn-vue.com/schema/registry.json",
  "name": "element-lab",
  "homepage": "https://github.com/nolotus/element-plus-registry-mcp-demo",
  "items": [
    {
      "name": "save-button",
      "type": "registry:component",
