        "element-plus"
      ],
      "files": [
        {
          "path": "src/components/UserCard.vue",
          "type": "registry:component",
          "target": "src/components/UserCard.vue"
        }
      ]
    },
    {
      "name": "user-table",
      "type": "registry:component",
      "title": "用户表格",
      "description": "带搜索过滤、成员角色和状态标签的 Element Plus 表格。",
      "dependencies": [
        "element-plus"
      ],
      "files": [
        {
          "path": "src/components/UserTable.vue",
          "type": "registry:component",
          "target": "src/components/UserTable.vue"
        }
      ]
    },
    {
      "name": "dashboard-template",
