      "dependencies": [
        "element-plus"
      ],
      "files": [
        {
          "path": "src/components/SaveButton.vue",
          "type": "registry:component",
          "target": "src/components/SaveButton.vue"
        }
      ]
    },
    {
      "name": "user-card",
