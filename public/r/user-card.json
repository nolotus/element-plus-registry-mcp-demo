{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "user-card",
  "type": "registry:component",
  "title": "用户卡片",
  "description": "显示用户姓名、邮箱、角色与状态，基于 Element Plus。",
  "dependencies": [
    "element-plus"
  ],
  "files": [
    {
      "path": "src/components/UserCard.vue",
      "type": "registry:component",
      "target": "src/components/UserCard.vue",
      "content": "<script setup lang=\"ts\">\nwithDefaults(defineProps<{ name: string; role?: string; email?: string; status?: 'active' | 'inactive' }>(), { role: '成员', email: '', status: 'active' })\n</script>\n<template>\n  <el-card shadow=\"hover\" class=\"user-card\">\n    <div class=\"user-card__inner\">\n      <el-avatar :size=\"44\" class=\"user-card__avatar\">{{ name.slice(0, 1) }}</el-avatar>\n      <div class=\"user-card__info\">\n        <strong>{{ name }}</strong><span>{{ role }} · {{ email }}</span>\n      </div>\n      <el-tag :type=\"status === 'active' ? 'success' : 'info'\" effect=\"light\">{{ status === 'active' ? '活跃' : '停用' }}</el-tag>\n    </div>\n  </el-card>\n</template>\n<style scoped>\n.user-card__inner{display:flex;align-items:center;gap:14px;min-width:0}.user-card__avatar{background:#e7efff;color:#3972d1;flex:none}.user-card__info{min-width:0;display:flex;flex:1;flex-direction:column;gap:6px}.user-card__info span{font-size:12px;color:#8a93a5;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\n</style>\n"
    }
  ]
}
